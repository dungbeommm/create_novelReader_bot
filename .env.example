# Create a bot with @BotFather. Never commit .env or send secrets into chat.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# Numeric Telegram user IDs, separated by commas. REQUIRED; empty = refuse startup.
ALLOWED_USER_IDS=123456789

# Optional cloud output. auto = Drive first, then GitHub Releases.
# off = only local files + Telegram (not for GitHub-hosted sessions).
CLOUD_UPLOAD=auto
# GitHub supplies GITHUB_REPOSITORY/GITHUB_TOKEN inside hosted Actions.
# For Docker/VPS, use a fine-grained PAT scoped to a PRIVATE output repository,
# with Contents: read/write. The Actions job token expires; do not use it on VPS.
GITHUB_REPOSITORY=owner/private-repository
GH_RELEASE_TOKEN=
# PUBLIC outputs are blocked unless explicitly set to true (not recommended).
ALLOW_PUBLIC_RELEASES=false

# Optional Drive OAuth (all four values are required together).
# Use drive.file scope; folder must be accessible to this OAuth app.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=

# Only needed for bounded GitHub-hosted sessions. Keep as an Actions Secret.
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHECKPOINT_KEY=
